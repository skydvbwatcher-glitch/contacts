rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isVerifiedUser() {
      return request.auth != null
        && request.auth.token.email is string
        && request.auth.token.email_verified == true;
    }

    function isOwner() {
      return isVerifiedUser()
        && request.auth.token.email == 'skydvbwatcher@gmail.com';
    }

    function accessConfig() {
      return get(/databases/$(database)/documents/contactAccess/config).data;
    }

    function isApprovedEditor() {
      return isVerifiedUser()
        && exists(/databases/$(database)/documents/contactAccess/$(request.auth.token.email))
        && get(/databases/$(database)/documents/contactAccess/$(request.auth.token.email)).data.email == request.auth.token.email
        && get(/databases/$(database)/documents/contactAccess/$(request.auth.token.email)).data.enabled == true;
    }

    function canAccessPrivateData(userId) {
      return (isOwner() && request.auth.uid == userId)
        || (isApprovedEditor() && userId == accessConfig().ownerUid);
    }

    function validNote(noteId) {
      return request.resource.data.keys().hasOnly([
          'type', 'title', 'tags', 'body', 'color', 'fileName',
          'byteSize', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.keys().hasAll([
          'type', 'title', 'tags', 'body', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.type in ['note', 'file']
        && request.resource.data.title is string
        && request.resource.data.tags is string
        && request.resource.data.body is string
        && request.resource.data.body.size() <= 900000
        && request.resource.data.createdAt is int
        && request.resource.data.updatedAt is int
        && (request.resource.data.type != 'note'
          || (request.resource.data.keys().hasAll(['color'])
            && request.resource.data.color in ['none', 'rose', 'amber', 'lemon', 'mint', 'sky', 'lilac']))
        && (request.resource.data.type != 'file'
          || (request.resource.data.keys().hasAll(['fileName', 'byteSize'])
            && request.resource.data.fileName is string
            && request.resource.data.byteSize is int
            && request.resource.data.byteSize >= 0))
        && noteId.size() <= 150;
    }

    match /contactAccess/config {
      allow get: if isVerifiedUser();
      allow list: if false;
      allow create: if isOwner()
        && request.resource.data.keys().hasOnly(['ownerUid'])
        && request.resource.data.ownerUid == request.auth.uid;
      allow update, delete: if false;
    }

    match /contactAccess/{email} {
      allow get: if isOwner() || (isVerifiedUser() && email == request.auth.token.email);
      allow list: if isOwner();
      allow create, update: if isOwner()
        && request.resource.data.keys().hasOnly(['email', 'enabled', 'updatedAt'])
        && request.resource.data.email == email
        && request.resource.data.enabled is bool;
      allow delete: if isOwner();
    }

    match /users/{userId}/privateData/{documentId} {
      allow read: if documentId == 'contacts'
        && canAccessPrivateData(userId);
      allow create, update: if documentId == 'contacts'
        && canAccessPrivateData(userId)
        && request.resource.data.keys().hasOnly(['contacts', 'updatedAt'])
        && request.resource.data.contacts is list;
      allow delete: if false;

      match /items/{noteId} {
        allow read: if documentId == 'notes' && canAccessPrivateData(userId);
        allow create, update: if documentId == 'notes'
          && canAccessPrivateData(userId)
          && validNote(noteId);
        allow delete: if documentId == 'notes' && canAccessPrivateData(userId);
      }
    }
  }
}
